{
  "compilerOptions": {
    "target": "es2023",
    "lib": [
      "ES2023",
      "DOM"
    ],
    "module": "esnext",
    "baseUrl": ".",
    "paths": {
      "@cxhub/shared": [
        "src/index.ts"
      ],
      "@cxhub/shared/ui": [
        "src/ui"
      ],
      "@cxhub/shared/ui/*": [
        "src/ui/*"
      ],
      "@cxhub/shared/utils": [
        "src/lib/utils.ts"
      ],
      "@cxhub/shared/theme": [
        "src/theme/theme.tsx"
      ]
    },
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true
  },
  "include": [
    "src"
  ]
}